rules_version = '2';

/**
 * @file firestore.rules
 * @description Reglas de Seguridad en Servidor para Cloud Firestore en Cuentas Claras.
 * Cumple con la Condición Técnica Obligatoria #2 (Control de Acceso y Aislamiento de Datos por Usuario).
 * Impide lecturas, escrituras y eliminaciones no autorizadas en el backend sin depender únicamente del cliente.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿El usuario autenticado es miembro del hogar indicado? (HU-09)
    // Si el hogar no existe, get() falla y la regla niega el acceso.
    function esMiembroDelHogar(hogarId) {
      return request.auth.uid in get(/databases/$(database)/documents/hogares/$(hogarId)).data.miembros;
    }

    // ------------------------------------------------------------------------------------------
    // CIFRADO DE DATOS (AES-256-GCM en el navegador, ver src/utils/cifrado.js)
    // Los textos y montos llegan cifrados con el formato enc:v1:<iv>:<datos>. El servidor no puede
    // leerlos, así que ya no valida su contenido (largo de la descripción, monto > 0, etc.): eso lo
    // hacen los modelos del cliente antes de cifrar. Aquí se exige que el campo SÍ venga cifrado y
    // que no supere el tamaño que tendría el texto más largo permitido una vez cifrado
    // (8 * caracteres + 48 para textos; 100 para números).
    // ------------------------------------------------------------------------------------------
    function esCifrado(v, largoMaximo) {
      return v is string && v.size() <= largoMaximo &&
        v.matches('^enc:v1:[A-Za-z0-9+/]{16}:[A-Za-z0-9+/]+={0,2}$');
    }

    function esNumeroCifrado(v) {
      return esCifrado(v, 100);
    }

    // Una clave AES-256 en base64 (32 bytes = 44 caracteres)
    function esClaveAes(v) {
      return v is string && v.matches('^[A-Za-z0-9+/]{43}=$');
    }

    // Estructura válida de un documento de /transacciones (espejo de src/models/Transaccion.js).
    // descripcion (máx. 120), monto, categoria y nombreUsuario (máx. 100) llegan cifrados.
    // tipo, ambito, creadoPor, fecha y hogarId van en claro porque las consultas y las reglas los usan.
    // hogarId es opcional (HU-09): null o el ID del hogar del autor.
    function esTransaccionValida(d) {
      return d.keys().hasOnly(['descripcion', 'monto', 'tipo', 'ambito', 'categoria',
                               'creadoPor', 'nombreUsuario', 'fecha', 'hogarId']) &&
        d.keys().hasAll(['descripcion', 'monto', 'tipo', 'ambito', 'categoria',
                         'creadoPor', 'fecha']) &&
        esCifrado(d.descripcion, 1008) &&
        esNumeroCifrado(d.monto) &&
        d.tipo in ['INGRESO', 'GASTO'] &&
        d.ambito in ['PERSONAL', 'COMPARTIDO'] &&
        esCifrado(d.categoria, 528) &&
        d.creadoPor is string &&
        (!('nombreUsuario' in d) || esCifrado(d.nombreUsuario, 848)) &&
        d.fecha is timestamp &&
        (d.get('hogarId', null) == null || d.hogarId is string);
    }

    // Estructura válida de un bolsillo (espejo de src/models/Bolsillo.js). Tarea 14.1:
    // antes no se limitaban los campos ni el largo del nombre. nombre (máx. 40), meta y montoAcumulado
    // llegan cifrados.
    function esBolsilloValido(d) {
      return d.keys().hasOnly(['nombre', 'meta', 'montoAcumulado', 'creadoPor', 'fecha']) &&
        d.keys().hasAll(['nombre', 'meta', 'montoAcumulado', 'creadoPor', 'fecha']) &&
        esCifrado(d.nombre, 368) &&
        esNumeroCifrado(d.meta) &&
        esNumeroCifrado(d.montoAcumulado) &&
        d.creadoPor is string &&
        d.fecha is timestamp;
    }

    // Estructura válida de una categoría personalizada (espejo de src/services/categorias.js). Tarea 14.1:
    // antes la actualización aceptaba cualquier campo y cualquier nombre. El nombre (máx. 40) llega cifrado.
    function esCategoriaValida(d) {
      return d.keys().hasOnly(['uid', 'nombre', 'tipo', 'fechaCreacion']) &&
        d.keys().hasAll(['uid', 'nombre']) &&
        d.uid is string &&
        esCifrado(d.nombre, 368) &&
        (!('tipo' in d) || d.tipo in ['gasto', 'ingreso']) &&
        (!('fechaCreacion' in d) || d.fechaCreacion is string);
    }

    // Reglas para la colección de transacciones financieras
    match /transacciones/{transaccionId} {
      
      // LECTURA: Cada usuario lee sus propios registros. Además, un miembro de un hogar lee los movimientos
      // COMPARTIDOS de los demás miembros de ese mismo hogar (HU-09, CA-9.5 y CA-9.6).
      // Los movimientos PERSONALES ajenos nunca se pueden leer.
      allow read: if request.auth != null && (
        resource.data.creadoPor == request.auth.uid ||
        (
          resource.data.ambito == 'COMPARTIDO' &&
          resource.data.get('hogarId', null) is string &&
          esMiembroDelHogar(resource.data.hogarId)
        )
      );

      // CREACIÓN: El usuario debe estar autenticado y su UID debe asignarse obligatoriamente como autor
      allow create: if request.auth != null &&
        request.resource.data.creadoPor == request.auth.uid &&
        esTransaccionValida(request.resource.data) &&
        // Si el movimiento trae hogarId (CA-9.4), el autor debe pertenecer a ese hogar
        (
          request.resource.data.get('hogarId', null) == null ||
          (request.resource.data.hogarId is string && esMiembroDelHogar(request.resource.data.hogarId))
        );

      // ACTUALIZACIÓN: Únicamente el autor original puede editar su registro y se prohíbe reasignar 'creadoPor'
      allow update: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid &&
        request.resource.data.creadoPor == resource.data.creadoPor &&
        request.resource.data.get('hogarId', null) == resource.data.get('hogarId', null) &&
        esTransaccionValida(request.resource.data);

      // ELIMINACIÓN: Únicamente el autor original del registro puede borrarlo
      allow delete: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid;
    }

    // Reglas para la colección de bolsillos de ahorro (HU-04 - CA-4.7)
    match /bolsillos/{bolsilloId} {
      // LECTURA: Aislamiento estricto por usuario
      allow read: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid;

      // CREACIÓN: Solo el usuario autenticado puede crear su propio bolsillo, con la estructura del modelo
      allow create: if request.auth != null &&
        request.resource.data.creadoPor == request.auth.uid &&
        esBolsilloValido(request.resource.data);

      // ACTUALIZACIÓN: creadoPor y fecha no cambian; solo se tocan nombre, meta y monto acumulado
      allow update: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'meta', 'montoAcumulado']) &&
        esBolsilloValido(request.resource.data);

      // ELIMINACIÓN: Solo el propietario puede eliminar su bolsillo
      allow delete: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid;
    }

    // Un abono de préstamo: { monto cifrado, fecha }
    function esAbonoValido(abono) {
      return abono is map &&
        abono.keys().hasOnly(['monto', 'fecha']) &&
        abono.keys().hasAll(['monto', 'fecha']) &&
        esNumeroCifrado(abono.monto) &&
        abono.fecha is timestamp;
    }

    // Reglas para la colección de préstamos a terceros (Tarea 8.2 / HU-08 - CA-8.8)
    match /prestamos/{prestamoId} {
      // LECTURA: Solo el usuario que prestó el dinero ve sus préstamos
      allow read: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid;

      // CREACIÓN: Préstamo propio, sin abonos y en estado PENDIENTE. deudor (3 a 60), monto, nota (máx. 200)
      // y totalAbonado (0) llegan cifrados; su contenido lo valida src/services/prestamos.js.
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['deudor', 'monto', 'fecha', 'nota', 'abonos', 'totalAbonado', 'estado', 'creadoPor']) &&
        request.resource.data.keys().hasAll(['deudor', 'monto', 'fecha', 'nota', 'abonos', 'totalAbonado', 'estado', 'creadoPor']) &&
        request.resource.data.creadoPor == request.auth.uid &&
        esCifrado(request.resource.data.deudor, 528) &&
        esNumeroCifrado(request.resource.data.monto) &&
        request.resource.data.fecha is timestamp &&
        esCifrado(request.resource.data.nota, 1648) &&
        request.resource.data.abonos == [] &&
        esNumeroCifrado(request.resource.data.totalAbonado) &&
        request.resource.data.estado == 'PENDIENTE';

      // ACTUALIZACIÓN (registrar un abono): solo cambian abonos, totalAbonado y estado.
      // Se agrega exactamente un abono, los anteriores no se pueden reescribir (Tarea 14.1) y un préstamo
      // SALDADO ya no recibe abonos. Con los montos cifrados, que el abono no supere el saldo (CA-8.4) y que
      // el estado coincida con el saldo (CA-8.5) lo calcula el servicio dentro de una transacción.
      allow update: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid &&
        resource.data.estado == 'PENDIENTE' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['abonos', 'totalAbonado', 'estado']) &&
        request.resource.data.abonos is list &&
        request.resource.data.abonos.size() == resource.data.abonos.size() + 1 &&
        (resource.data.abonos.size() == 0 ||
          request.resource.data.abonos[0:resource.data.abonos.size()] == resource.data.abonos) &&
        esAbonoValido(request.resource.data.abonos[resource.data.abonos.size()]) &&
        esNumeroCifrado(request.resource.data.totalAbonado) &&
        request.resource.data.estado in ['PENDIENTE', 'SALDADO'];

      // ELIMINACIÓN: Solo el propietario puede eliminar su préstamo
      allow delete: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid;
    }

    // Reglas para la colección de hogares compartidos (Tarea 9.2 / HU-09)
    // El ID del documento es el código de invitación de 6 caracteres.
    match /hogares/{codigo} {
      // CONSULTA POR CÓDIGO: cualquier usuario autenticado que conozca el código puede leer ese hogar
      // para unirse (CA-9.2). Sin el código no puede listar hogares ajenos.
      allow get: if request.auth != null;

      // LISTADO: solo los hogares de los que el usuario es miembro (consulta array-contains por su UID)
      allow list: if request.auth != null &&
        request.auth.uid in resource.data.miembros;

      // CREACIÓN (CA-9.1): el creador es el único miembro inicial y el ID coincide con el código
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['nombre', 'codigo', 'miembros', 'nombres', 'creadoPor', 'fecha']) &&
        codigo.matches('^[A-Z0-9]{6}$') &&
        request.resource.data.codigo == codigo &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.miembros == [request.auth.uid] &&
        request.resource.data.nombres is map &&
        request.resource.data.nombres.keys().hasOnly([request.auth.uid]) &&
        request.resource.data.nombres[request.auth.uid] is string &&
        request.resource.data.nombres[request.auth.uid].size() <= 60 &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() >= 3 &&
        request.resource.data.nombre.size() <= 40 &&
        request.resource.data.fecha is timestamp;

      // ACTUALIZACIÓN: cada usuario solo puede agregarse o quitarse a sí mismo.
      // Unirse (CA-9.2): no era miembro, queda al final de la lista y no se supera el máximo de 6.
      // Salir (CA-9.7): era miembro y se quita solo a sí mismo.
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros', 'nombres']) &&
        request.resource.data.nombres.diff(resource.data.nombres).affectedKeys().hasOnly([request.auth.uid]) &&
        // Tarea 14.1: el nombre visible que se agrega es texto de máximo 60 caracteres
        (
          !(request.auth.uid in request.resource.data.nombres) ||
          (request.resource.data.nombres[request.auth.uid] is string &&
           request.resource.data.nombres[request.auth.uid].size() <= 60)
        ) &&
        (
          (
            !(request.auth.uid in resource.data.miembros) &&
            request.resource.data.miembros == resource.data.miembros.concat([request.auth.uid]) &&
            request.resource.data.miembros.size() <= 6
          ) ||
          (
            request.auth.uid in resource.data.miembros &&
            request.resource.data.miembros == resource.data.miembros.removeAll([request.auth.uid])
          )
        );

      // ELIMINACIÓN: solo cuando el último miembro sale del hogar
      allow delete: if request.auth != null &&
        resource.data.miembros == [request.auth.uid];
    }

    // Reglas para la colección de liquidaciones del hogar (Tarea 11.2 / HU-11 - CA-11.5 y CA-11.6)
    // El ID del documento es '{hogarId}_{AAAA-MM}': una liquidación por hogar y por mes.
    match /liquidaciones/{liquidacionId} {
      // LECTURA: solo los miembros del hogar. El hogar se toma del ID para que también se pueda
      // consultar un mes que aún no se ha saldado (el documento no existe todavía).
      allow read: if request.auth != null &&
        liquidacionId.matches('^[A-Z0-9]{6}_[0-9]{4}-(0[1-9]|1[0-2])$') &&
        esMiembroDelHogar(liquidacionId.split('_')[0]);

      // CREACIÓN: un miembro del hogar marca el mes como saldado a su nombre, con la hora del servidor
      // y como máximo 5 transferencias (con 6 miembros, el cuadre nunca necesita más).
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['hogarId', 'periodo', 'transferencias', 'saldadaPor', 'fecha']) &&
        request.resource.data.keys().hasAll(['hogarId', 'periodo', 'transferencias', 'saldadaPor', 'fecha']) &&
        request.resource.data.hogarId is string &&
        request.resource.data.periodo is string &&
        request.resource.data.periodo.matches('^[0-9]{4}-(0[1-9]|1[0-2])$') &&
        liquidacionId == request.resource.data.hogarId + '_' + request.resource.data.periodo &&
        esMiembroDelHogar(request.resource.data.hogarId) &&
        request.resource.data.saldadaPor == request.auth.uid &&
        // Las transferencias (máximo 5, lo valida el servicio) llegan como una sola lista cifrada
        esCifrado(request.resource.data.transferencias, 4000) &&
        request.resource.data.fecha == request.time;

      // Sin update ni delete: una liquidación guardada queda como registro del cuadre.
    }

    // Reglas para la colección de categorías personalizadas (HU-12)
    match /categorias/{categoriaId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid &&
        esCategoriaValida(request.resource.data);
      // Tarea 14.1: el dueño no cambia y la categoría editada sigue siendo válida
      allow update: if request.auth != null &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == request.auth.uid &&
        esCategoriaValida(request.resource.data);
    }

    // Llavero personal de cifrado (src/services/claves.js): solo su dueño lo lee.
    // La clave personal se crea una vez y nunca cambia; después solo se agregan copias de claves de hogar.
    match /clavesUsuario/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['clave', 'hogares']) &&
        request.resource.data.keys().hasAll(['clave', 'hogares']) &&
        esClaveAes(request.resource.data.clave) &&
        request.resource.data.hogares == {};

      allow update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hogares']) &&
        request.resource.data.hogares is map &&
        request.resource.data.hogares.size() <= 20 &&
        request.resource.data.hogares.diff(resource.data.hogares).changedKeys().size() == 0 &&
        request.resource.data.hogares.diff(resource.data.hogares).removedKeys().size() == 0;

      // Sin delete: borrar la clave dejaría ilegibles los datos cifrados con ella.
    }

    // Clave compartida de cada hogar (ID = código del hogar): solo la leen sus miembros.
    // La crea el primer miembro que la necesita y nunca cambia ni se borra.
    match /clavesHogar/{codigo} {
      allow read: if request.auth != null && esMiembroDelHogar(codigo);

      allow create: if request.auth != null &&
        codigo.matches('^[A-Z0-9]{6}$') &&
        esMiembroDelHogar(codigo) &&
        request.resource.data.keys().hasOnly(['clave', 'creadoPor']) &&
        request.resource.data.keys().hasAll(['clave', 'creadoPor']) &&
        esClaveAes(request.resource.data.clave) &&
        request.resource.data.creadoPor == request.auth.uid;
    }

    // Por defecto, denegar cualquier acceso no especificado a la base de datos
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
