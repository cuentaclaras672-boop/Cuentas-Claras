rules_version = '2';

/**
 * @file firestore.rules
 * @description Reglas de Seguridad en Servidor para Cloud Firestore en Cuentas Claras.
 * Cumple con la Condición Técnica Obligatoria #2 (Control de Acceso y Aislamiento de Datos por Usuario).
 * Impide lecturas, escrituras y eliminaciones no autorizadas en el backend sin depender únicamente del cliente.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ¿El usuario autenticado es miembro del hogar indicado? (HU-09)
    // Si el hogar no existe, get() falla y la regla niega el acceso.
    function esMiembroDelHogar(hogarId) {
      return request.auth.uid in get(/databases/$(database)/documents/hogares/$(hogarId)).data.miembros;
    }

    // Reglas para la colección de transacciones financieras
    match /transacciones/{transaccionId} {
      
      // LECTURA: Cada usuario lee sus propios registros. Además, un miembro de un hogar lee los movimientos
      // COMPARTIDOS de los demás miembros de ese mismo hogar (HU-09, CA-9.5 y CA-9.6).
      // Los movimientos PERSONALES ajenos nunca se pueden leer.
      allow read: if request.auth != null && (
        resource.data.creadoPor == request.auth.uid ||
        (
          resource.data.ambito == 'COMPARTIDO' &&
          resource.data.get('hogarId', null) is string &&
          esMiembroDelHogar(resource.data.hogarId)
        )
      );

      // CREACIÓN: El usuario debe estar autenticado y su UID debe asignarse obligatoriamente como autor
      allow create: if request.auth != null &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.monto is number &&
        request.resource.data.monto > 0 &&
        request.resource.data.tipo in ['INGRESO', 'GASTO'] &&
        request.resource.data.ambito in ['PERSONAL', 'COMPARTIDO'] &&
        // Si el movimiento trae hogarId (CA-9.4), el autor debe pertenecer a ese hogar
        (
          request.resource.data.get('hogarId', null) == null ||
          (request.resource.data.hogarId is string && esMiembroDelHogar(request.resource.data.hogarId))
        );

      // ACTUALIZACIÓN: Únicamente el autor original puede editar su registro y se prohíbe reasignar 'creadoPor'
      allow update: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid &&
        request.resource.data.creadoPor == resource.data.creadoPor &&
        request.resource.data.get('hogarId', null) == resource.data.get('hogarId', null) &&
        request.resource.data.monto is number &&
        request.resource.data.monto > 0 &&
        request.resource.data.tipo in ['INGRESO', 'GASTO'] &&
        request.resource.data.ambito in ['PERSONAL', 'COMPARTIDO'];

      // ELIMINACIÓN: Únicamente el autor original del registro puede borrarlo
      allow delete: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid;
    }

    // Reglas para la colección de bolsillos de ahorro (HU-04 - CA-4.7)
    match /bolsillos/{bolsilloId} {
      // LECTURA: Aislamiento estricto por usuario
      allow read: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid;

      // CREACIÓN: Solo el usuario autenticado puede crear su propio bolsillo
      allow create: if request.auth != null &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.nombre is string &&
        request.resource.data.meta is number &&
        request.resource.data.meta > 0 &&
        request.resource.data.montoAcumulado is number &&
        request.resource.data.montoAcumulado >= 0;

      // ACTUALIZACIÓN: Inmutabilidad de creadoPor y validación de tipos
      allow update: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid &&
        request.resource.data.creadoPor == resource.data.creadoPor &&
        request.resource.data.meta is number &&
        request.resource.data.meta > 0 &&
        request.resource.data.montoAcumulado is number &&
        request.resource.data.montoAcumulado >= 0;

      // ELIMINACIÓN: Solo el propietario puede eliminar su bolsillo
      allow delete: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid;
    }

    // Reglas para la colección de préstamos a terceros (Tarea 8.2 / HU-08 - CA-8.8)
    match /prestamos/{prestamoId} {
      // LECTURA: Solo el usuario que prestó el dinero ve sus préstamos
      allow read: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid;

      // CREACIÓN: Préstamo propio, con deudor y monto válidos, sin abonos y en estado PENDIENTE
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['deudor', 'monto', 'fecha', 'nota', 'abonos', 'totalAbonado', 'estado', 'creadoPor']) &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.deudor is string &&
        request.resource.data.deudor.size() >= 3 &&
        request.resource.data.deudor.size() <= 60 &&
        request.resource.data.monto is number &&
        request.resource.data.monto > 0 &&
        request.resource.data.fecha is timestamp &&
        request.resource.data.nota is string &&
        request.resource.data.nota.size() <= 200 &&
        request.resource.data.abonos == [] &&
        request.resource.data.totalAbonado == 0 &&
        request.resource.data.estado == 'PENDIENTE';

      // ACTUALIZACIÓN (registrar un abono): solo cambian abonos, totalAbonado y estado.
      // Se agrega exactamente un abono, el total abonado nunca baja ni supera el monto prestado (CA-8.4)
      // y el estado debe coincidir con el saldo: SALDADO solo cuando el pendiente llega a 0 (CA-8.5).
      allow update: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['abonos', 'totalAbonado', 'estado']) &&
        request.resource.data.abonos is list &&
        request.resource.data.abonos.size() == resource.data.abonos.size() + 1 &&
        request.resource.data.totalAbonado is number &&
        request.resource.data.totalAbonado > resource.data.totalAbonado &&
        request.resource.data.totalAbonado <= resource.data.monto &&
        (
          (request.resource.data.totalAbonado == resource.data.monto && request.resource.data.estado == 'SALDADO') ||
          (request.resource.data.totalAbonado < resource.data.monto && request.resource.data.estado == 'PENDIENTE')
        );

      // ELIMINACIÓN: Solo el propietario puede eliminar su préstamo
      allow delete: if request.auth != null &&
        resource.data.creadoPor == request.auth.uid;
    }

    // Reglas para la colección de hogares compartidos (Tarea 9.2 / HU-09)
    // El ID del documento es el código de invitación de 6 caracteres.
    match /hogares/{codigo} {
      // CONSULTA POR CÓDIGO: cualquier usuario autenticado que conozca el código puede leer ese hogar
      // para unirse (CA-9.2). Sin el código no puede listar hogares ajenos.
      allow get: if request.auth != null;

      // LISTADO: solo los hogares de los que el usuario es miembro (consulta array-contains por su UID)
      allow list: if request.auth != null &&
        request.auth.uid in resource.data.miembros;

      // CREACIÓN (CA-9.1): el creador es el único miembro inicial y el ID coincide con el código
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(['nombre', 'codigo', 'miembros', 'nombres', 'creadoPor', 'fecha']) &&
        codigo.matches('^[A-Z0-9]{6}$') &&
        request.resource.data.codigo == codigo &&
        request.resource.data.creadoPor == request.auth.uid &&
        request.resource.data.miembros == [request.auth.uid] &&
        request.resource.data.nombres is map &&
        request.resource.data.nombres.keys().hasOnly([request.auth.uid]) &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() >= 3 &&
        request.resource.data.nombre.size() <= 40 &&
        request.resource.data.fecha is timestamp;

      // ACTUALIZACIÓN: cada usuario solo puede agregarse o quitarse a sí mismo.
      // Unirse (CA-9.2): no era miembro, queda al final de la lista y no se supera el máximo de 6.
      // Salir (CA-9.7): era miembro y se quita solo a sí mismo.
      allow update: if request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['miembros', 'nombres']) &&
        request.resource.data.nombres.diff(resource.data.nombres).affectedKeys().hasOnly([request.auth.uid]) &&
        (
          (
            !(request.auth.uid in resource.data.miembros) &&
            request.resource.data.miembros == resource.data.miembros.concat([request.auth.uid]) &&
            request.resource.data.miembros.size() <= 6
          ) ||
          (
            request.auth.uid in resource.data.miembros &&
            request.resource.data.miembros == resource.data.miembros.removeAll([request.auth.uid])
          )
        );

      // ELIMINACIÓN: solo cuando el último miembro sale del hogar
      allow delete: if request.auth != null &&
        resource.data.miembros == [request.auth.uid];
    }

    // Por defecto, denegar cualquier acceso no especificado a la base de datos
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
